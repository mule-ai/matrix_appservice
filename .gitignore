# Environment files
.env
.env.local
.env.*.local

# Binary outputs (paths under pi-sessions/, not the cmd/ sources)
# Don't blanket-match 'pi-matrix' as a substring -- it also
# matches pi-sessions/cmd/pi-matrix/main.go and excludes the source.

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
tmp/
temp/
pi-sessions/pi-session-manager
pi-sessions/pi-matrix
pi-sessions/*.tar.gz
pi-sessions/pkg/bridge/*.go

# pi-session-manager is retired (see SPEC). The reference source is
# kept locally for the dev who wants to grep it; the SPEC says not
# to commit it. Add the path explicitly so 'git add -A' doesn't
# sweep it in.
pi-sessions/cmd/pi-session-manager/

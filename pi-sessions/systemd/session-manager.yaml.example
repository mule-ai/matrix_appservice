# Pi Session Manager Configuration
# /etc/pi-matrix/session-manager.yaml

session_manager:
  # Network settings
  host: 0.0.0.0
  port: 8081
  
  # API key for authenticating appservice connections
  # Generate with: openssl rand -base64 32
  api_key: ""
  
  # Path to pi executable
  pi_path: /usr/local/bin/pi
  
  # Agent directory for pi
  agent_dir: /var/lib/pi/agent
  
  # Session limits
  max_sessions: 10
  
  # Session timeout in seconds (0 = no timeout)
  session_timeout: 3600

# Logging
logging:
  level: info
  format: console
  writers:
    - stdout

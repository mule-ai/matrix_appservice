[Unit]
Description=Pi Session Manager - Manages pi subprocesses via RPC
Documentation=https://github.com/mule-ai/pi-matrix
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/pi-matrix
ExecStart=/opt/pi-matrix/pi-session-manager -c /etc/pi-matrix/session-manager.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# Environment
Environment=PI_AGENT_DIR=/var/lib/pi/agent

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pi /var/log/pi-matrix /tmp

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pi-session-manager

# Resource limits
LimitNOFILE=65536
MemoryMax=512M

[Install]
WantedBy=multi-user.target

# Pi Matrix Appservice Configuration
# /etc/pi-matrix/config.yaml
#
# This config is for the pi-matrix appservice (runs on Matrix homeserver).
# The session manager (pi-session-manager) runs separately on each machine.

homeserver:
  # Matrix homeserver address
  address: http://localhost:8008
  
  # Matrix homeserver domain (for user IDs)
  domain: matrix.example.com

appservice:
  # Unique ID for this appservice
  id: pi-matrix
  
  # Localpart for the appservice bot (@pi-matrix:domain)
  localpart: pi-matrix
  
  # URL where this appservice is reachable (from homeserver perspective)
  url: http://0.0.0.0:8080
  
  # Port the appservice listens on
  port: 8080
  
  # Path to registration file
  registration_path: /etc/pi-matrix/registration.yaml
  
  # Auto-generate registration file
  auto_generate_registration: true
  
  # Tokens (set via environment variables in systemd)
  as_token: "${APPSERVICE_AS_TOKEN}"
  hs_token: "${APPSERVICE_HS_TOKEN}"

api:
  # HTTP server binding
  host: 0.0.0.0
  port: 8080

bridge:
  # Room name prefix (machine name will be appended)
  room_name_prefix: "Pi"
  
  # Auto-create rooms
  auto_create_rooms: true
  
  # Delete rooms when sessions exit
  delete_rooms_on_exit: false
  
  # Session limits (0 = unlimited)
  max_sessions: 0
  session_timeout: 0

database:
  # SQLite database path
  url: /var/lib/pi-matrix/bridge.db

# Session Managers - connect to multiple pi-session-manager instances
# Each machine that runs pi needs its own session manager
session_managers:
  managers:
    - name: "desktop"
      url: http://192.168.1.10:19081
      api_key: ""
    - name: "laptop"
      url: http://192.168.1.20:19081
      api_key: ""
    - name: "server"
      url: http://server.example.com:19081
      api_key: ""

# pi executable settings (used by session managers to spawn pi)
pi:
  path: /usr/local/bin/pi
  agent_dir: ~/.pi/agent

# Logging
logging:
  level: info
  format: console
  writers:
    - stdout
